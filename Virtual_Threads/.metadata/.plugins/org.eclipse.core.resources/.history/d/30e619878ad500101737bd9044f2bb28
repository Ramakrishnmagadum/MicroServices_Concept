package com.example.virtualThreadExample;

import java.util.concurrent.CountDownLatch;

public class DifferencingInTime {
	public static void main(String[] args) throws InterruptedException {

		// Creating Platform Threads :-
		int numOfThreads = 1000;
		CountDownLatch countDownLatch = new CountDownLatch(1000);

		Long startTime = System.currentTimeMillis();
		for (int i = 0; i < numOfThreads; i++) {
			Thread platform = Thread.ofPlatform().unstarted(() -> Task());
			platform.start();
			countDownLatch.countDown();
		}
		Long endTime = System.currentTimeMillis();
		countDownLatch.await();
		System.out.println("Platform Threads taken Time " + (endTime - startTime) + " MiliSeconds");
	}

	public static void Task() {
		System.out.println("Start Thread " + Thread.currentThread().getName());
		try {
			Thread.sleep(1000);
		} catch (InterruptedException e) {
			e.printStackTrace();
		}
		System.out.println("End Thread " + Thread.currentThread().getName());
	}
}
