		System.out.println("________________________________________________");
		AtomicInteger atomicInteger2= new AtomicInteger();
		int numOfVirtualThreads =1000;
	CountDownLatch countDownLatch2= new CountDownLatch(numOfVirtualThreads);
		List<Thread>  virtualThreads= new ArrayList<>(); 
		Long startTime2 = System.currentTimeMillis();
		for (int i = 0; i < numOfVirtualThreads; i++) {
			Thread virtualThread = Thread.ofVirtual().unstarted(() -> Task());
			virtualThreads.add(virtualThread);
			
		}
		
		for (Thread virtualThread : virtualThreads) {
			virtualThread.start();
			countDownLatch2.countDown();
			atomicInteger2.getAndIncrement();
		}
		countDownLatch2.await();
		Long endTime2 = System.currentTimeMillis();
		System.out.println("Virtual  Threads taken Time " + (endTime2 - startTime2) + " MiliSeconds");
		System.out.println("No of Threads are created "+ atomicInteger2);
		
		
	}

	public static void Task() {
		System.out.println("Start Thread " + Thread.currentThread().getName());
		try {
			Thread.sleep(1000);
		} catch (InterruptedException e) {
			e.printStackTrace();
		}
		System.out.println("End Thread " + Thread.currentThread().getName());
	}
}
